# Principal dApp environment. Copy to .env.local and fill in; never commit real keys.

# Which deployment manifest the app uses: "testnet" (default) or "local"
# (config/manifests/local.json, written by scripts/dev-stack/deploy.sh).
NEXT_PUBLIC_PRINCIPAL_NETWORK=testnet

# Server only: read by the Get test tokens route (app/api/faucet/route.ts), never sent to the browser.
# Do not prefix these with NEXT_PUBLIC_.

# Required. Secret key (S...) of the test asset issuer, which is also its SAC admin. It authorizes
# trustlines (SAC set_authorized) and pays the test tokens.
FAUCET_ISSUER_SECRET=

# Optional. Secret key (S...) of the Permissioning admin, which grants accounts and PT/YT access.
# Defaults to FAUCET_ISSUER_SECRET when empty.
FAUCET_PERMISSIONING_ADMIN_SECRET=

# Server only: Postgres for the market snapshot recorder (lib/server/db.ts) and the migration script.
# Do not prefix these with NEXT_PUBLIC_. Neon: DATABASE_URL is the pooled string; migrations use
# DATABASE_URL_UNPOOLED if set, else DATABASE_URL with "-pooler" removed from the host.
# Local dev (scripts/dev-stack) writes DATABASE_URL to .env.local for the principal-pg container.
DATABASE_URL=postgres://user:password@host/dbname
DATABASE_URL_UNPOOLED=

# Server only: who may call GET /api/cron/record. Either header is accepted:
#   Authorization: Bearer $CRON_SECRET   (Vercel Cron sends this when CRON_SECRET is set)
#   Upstash-Signature                    (QStash; verified with the two signing keys)
CRON_SECRET=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Server only, testnet and local only: the oracle admin key GET/POST /api/cron/oracle signs with.
# It can only push the oracle value. Never set on mainnet (the route refuses to run there).
ORACLE_ADMIN_SECRET=
