# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# live Testnet run records (pnpm test:e2e:testnet): transaction hashes and public keys, kept per run
/e2e-artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Neon database credentials per network (Tranche 2 testnet, Tranche 3 mainnet); never commit
.env.testnet
.env.mainnet
# the documented template holds no secrets (R9)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated local manifest (scripts/ensure-local-manifest.mjs, scripts/dev-stack/deploy.sh)
/config/manifests/local.json

# superpowers workspaces (SDD ledgers, brainstorm mock-ups)
.superpowers/
